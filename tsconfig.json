{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "ajo",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "packages/ajo-*/bin/**/*.ts",
    "packages/ajo-*/src/**/*.ts",
    "packages/ajo-*/src/**/*.tsx",
    "packages/ajo-*/tests/**/*.ts",
    "packages/ajo-*/tests/**/*.tsx",
    "packages/ajo-*/stories/**/*.ts",
    "packages/ajo-*/stories/**/*.tsx"
  ],
  "exclude": ["packages/demo", "packages/template", "**/dist", "**/node_modules"]
}
