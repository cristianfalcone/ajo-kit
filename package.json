{
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "kit": "kit",
    "dev": "kit dev",
    "stories": "tsx tests/stories-server.ts dev",
    "stories:test": "tsx tests/stories-server.ts test",
    "stories:test:visual": "tsx tests/stories-server.ts test --screenshots",
    "build": "kit build",
    "start": "kit start",
    "test": "vitest run",
    "test:bundle": "tsx tests/virtual-list-bundle.ts",
    "test:consumer:playa": "tsx tests/playa-consumer.ts",
    "test:perf:data-table": "node --expose-gc --import tsx packages/ajo-ui/tests/data-table-performance.ts",
    "test:unit": "vitest run && pnpm test:bundle",
    "test:e2e": "playwright test",
    "test:prod": "pnpm build && playwright test -c playwright.production.config.ts",
    "test:all": "pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "ajo": "0.1.35",
    "ajo-auth": "workspace:*",
    "ajo-backup": "workspace:*",
    "ajo-cloves": "workspace:*",
    "ajo-kit": "workspace:*",
    "ajo-ui-playa": "workspace:*",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "25.9.3",
    "ajo-ui": "workspace:*",
    "@vitest/browser-playwright": "4.1.9",
    "happy-dom": "^20.10.6",
    "playwright": "1.61.0",
    "sade": "^1.8.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "unocss": "66.7.2",
    "verdaccio": "6.8.0",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
