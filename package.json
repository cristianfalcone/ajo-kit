{
  "name": "ajo-kit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "pnpm --filter ajo-kit-demo dev",
    "stories": "pnpm --filter ajo-ui-playa stories",
    "stories:test": "pnpm --filter ajo-ui-playa stories:test",
    "stories:test:visual": "pnpm --filter ajo-ui-playa stories:test:visual",
    "build": "pnpm --filter ajo-kit-demo build",
    "typecheck": "tsc --noEmit && pnpm --filter ajo-kit-demo typecheck && pnpm --filter ajo-kit-template typecheck",
    "test:consumer:packages": "tsx tests/package-consumer.ts",
    "repack:sync": "tsx scripts/repack-sync.ts",
    "release:verify": "pnpm typecheck && pnpm test:unit && pnpm test:consumer:packages",
    "release:plan": "pnpm version -r --dry-run",
    "test:unit": "vitest run && pnpm --filter ajo-kit-demo test && pnpm --filter ajo-ui test:bundle",
    "test:e2e": "pnpm --filter ajo-kit-demo test:e2e",
    "test:all": "pnpm test:unit && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "ajo": "0.2.0",
    "ajo-ui-playa": "workspace:*",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unocss": "66.10.5",
    "verdaccio": "6.10.4",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
