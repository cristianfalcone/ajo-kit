{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "ajo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "/src/*": ["./src/*"],
      "@kit": ["./node_modules/ajo-kit/src/index.ts"],
      "@kit/auth": ["./node_modules/ajo-kit-auth/src/index.ts"],
      "@kit/auth/ability": ["./node_modules/ajo-kit-auth/src/ability.client.ts"],
      "@kit/database": ["./node_modules/ajo-kit/src/database.node.ts"],
      "@kit/platform": ["./node_modules/ajo-kit/src/platform.node.ts"],
      "@kit/*": ["./node_modules/ajo-kit/src/*"]
    }
  }
}
