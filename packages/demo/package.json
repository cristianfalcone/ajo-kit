{
  "name": "ajo-kit-demo",
  "private": true,
  "type": "module",
  "kit": {
    "engine": {
      "fs": {
        "roots": [
          "/ajo/data"
        ]
      }
    }
  },
  "scripts": {
    "kit": "tsx node_modules/ajo-kit/bin/kit.ts",
    "dev": "pnpm kit dev",
    "build": "pnpm kit build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:acceptance": "playwright test -c playwright.acceptance.config.ts"
  },
  "dependencies": {
    "ajo": "0.2.0",
    "ajo-cloves": "workspace:*",
    "ajo-kit": "workspace:*",
    "ajo-kit-auth": "workspace:*",
    "ajo-kit-mail": "workspace:*",
    "ajo-ui-playa": "workspace:*",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "better-sqlite3": "13.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unocss": "66.10.5",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "optionalDependencies": {
    "ajo-engine": "0.2.0",
    "ajo-engine-compiler": "0.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
