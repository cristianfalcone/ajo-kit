# Local development. `node scripts/setup.mjs` creates .env with a random APP_SECRET.
APP_URL=http://localhost:5173
APP_SECRET=
DATABASE_PATH=./database.sqlite
# Development uses in-memory capture and never connects to this provider.
MAIL_FROM=notes@example.test
# Optional in production: with none of the three set, mail is off and every send is
# refused. Set all three in the admin Secrets screen to turn mail on.
MAIL_URL=
MAIL_TOKEN=
