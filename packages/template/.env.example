# Local development. `pnpm setup` creates .env with a random APP_SECRET.
APP_URL=http://localhost:5173
APP_SECRET=
DATABASE_PATH=./database.sqlite
# Development uses in-memory capture and never connects to this provider.
MAIL_FROM=notes@example.test
# Required by the sealed production artifact. Supply real values on the host.
MAIL_URL=
MAIL_TOKEN=
