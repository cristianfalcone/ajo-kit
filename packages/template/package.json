{
  "name": "ajo-kit-template",
  "private": true,
  "type": "module",
  "kit": {
    "engine": {
      "fs": {
        "roots": [
          "/ajo/data"
        ]
      },
      "env": {
        "required": [
          "MAIL_FROM",
          "MAIL_URL",
          "MAIL_TOKEN"
        ]
      }
    }
  },
  "scripts": {
    "kit": "kit",
    "setup": "node scripts/setup.mjs",
    "dev": "kit dev",
    "build": "kit build",
    "artifact": "kit build --compiler ajo-engine-compiler",
    "start": "ajo-engine dist/ajo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "kit deploy"
  },
  "dependencies": {
    "ajo": "0.2.0",
    "ajo-kit": "0.4.0",
    "ajo-kit-auth": "0.7.0",
    "ajo-kit-mail": "0.4.0",
    "ajo-ui-playa": "0.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "ajo-kit-server": "0.2.0",
    "typescript": "6.0.3",
    "unocss": "66.10.5",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.15.0"
}
