{
  "name": "ajo-kit",
  "version": "0.3.2",
  "description": "Full-stack metaframework for Ajo applications",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "kit": "./bin/kit.ts"
  },
  "scripts": {
    "build": "pnpm -w exec tsx scripts/package-build.ts ajo-kit",
    "prepack": "pnpm run build",
    "test": "pnpm -w exec vitest run packages/ajo-kit/tests"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.tsx",
      "default": "./src/server.tsx"
    },
    "./client": {
      "types": "./src/client.tsx",
      "default": "./src/client.tsx"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "default": "./src/engine.ts"
    },
    "./platform": {
      "types": "./src/platform.ts",
      "browser": "./src/platform.client.ts",
      "ajo": "./src/platform.ajo.ts",
      "default": "./src/platform.node.ts"
    },
    "./validate": {
      "types": "./src/validate.ts",
      "default": "./src/validate.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./database": {
      "types": "./src/database.ts",
      "ajo": "./src/database.ajo.ts",
      "default": "./src/database.node.ts"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.4",
    "kysely": "0.29.6",
    "navaid": "1.2.0",
    "sade": "1.8.1",
    "valibot": "1.5.0"
  },
  "peerDependencies": {
    "ajo": "^0.1.35",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "ajo": "0.1.35",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "ajo",
    "framework",
    "vite",
    "sqlite",
    "ssr"
  ],
  "author": "Cristian Falcone",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianfalcone/ajo-kit.git",
    "directory": "packages/ajo-kit"
  },
  "bugs": {
    "url": "https://github.com/cristianfalcone/ajo-kit/issues"
  },
  "homepage": "https://github.com/cristianfalcone/ajo-kit/tree/main/packages/ajo-kit#readme",
  "publishConfig": {
    "access": "public"
  }
}
