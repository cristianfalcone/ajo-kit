{
  "name": "ajo-kit",
  "version": "0.1.5",
  "description": "Full-stack metaframework for Ajo applications",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "kit": "./bin/kit.ts"
  },
  "scripts": {
    "build": "pnpm -w exec tsx scripts/package-build.ts ajo-kit",
    "prepack": "pnpm run build",
    "test": "pnpm -w exec vitest run packages/ajo-kit/tests"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.tsx",
      "default": "./src/server.tsx"
    },
    "./client": {
      "types": "./src/client.tsx",
      "default": "./src/client.tsx"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "default": "./src/engine.ts"
    },
    "./platform": {
      "types": "./src/platform.ts",
      "browser": "./src/platform.client.ts",
      "ajo": "./src/platform.ajo.ts",
      "default": "./src/platform.node.ts"
    },
    "./bytes": {
      "types": "./src/bytes.ts",
      "default": "./src/bytes.ts"
    },
    "./validate": {
      "types": "./src/validate.ts",
      "default": "./src/validate.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./mail": {
      "types": "./src/mail/index.ts",
      "default": "./src/mail/index.ts"
    },
    "./database": {
      "types": "./src/database.ts",
      "ajo": "./src/database.ajo.ts",
      "default": "./src/database.node.ts"
    }
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "devalue": "^5.8.1",
    "dotenv": "^17.4.2",
    "kysely": "^0.29.2",
    "navaid": "^1.2.0",
    "polka": "1.0.0-next.28",
    "sade": "^1.8.1",
    "valibot": "^1.4.1"
  },
  "peerDependencies": {
    "ajo": "^0.1.35",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "ajo": "0.1.35",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": ["ajo", "framework", "vite", "sqlite", "ssr"],
  "author": "Cristian Falcone",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianfalcone/ajo-kit.git",
    "directory": "packages/ajo-kit"
  },
  "bugs": {
    "url": "https://github.com/cristianfalcone/ajo-kit/issues"
  },
  "homepage": "https://github.com/cristianfalcone/ajo-kit/tree/main/packages/ajo-kit#readme",
  "publishConfig": {
    "access": "public"
  }
}
