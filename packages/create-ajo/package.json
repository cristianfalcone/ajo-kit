{
  "name": "create-ajo",
  "version": "0.1.1",
  "description": "Creates an Ajo App from the ajo-kit starter: pnpm create ajo <dir>",
  "type": "module",
  "bin": {
    "create-ajo": "./src/index.ts"
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm -w exec tsx scripts/package-build.ts create-ajo",
    "prepack": "pnpm run build",
    "test": "pnpm -w exec vitest run packages/create-ajo/tests"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianfalcone/ajo-kit.git",
    "directory": "packages/create-ajo"
  },
  "homepage": "https://github.com/cristianfalcone/ajo-kit/tree/main/packages/create-ajo#readme",
  "license": "ISC",
  "keywords": [
    "ajo",
    "ajo-kit",
    "create",
    "starter"
  ]
}
